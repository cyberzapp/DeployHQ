rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidImageUpload() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isValidReportUpload() {
      return request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('text/csv')
            || request.resource.contentType.matches('application/pdf')
            || request.resource.contentType.matches('application/json'));
    }

    // User avatars: users/{uid}/avatar/*
    match /users/{uid}/avatar/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == uid && isValidImageUpload();
    }

    // Workspace assets & logos: workspaces/{workspaceId}/assets/*
    match /workspaces/{workspaceId}/assets/{fileName} {
      allow read: if isAuthenticated()
        && firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
      allow write: if isAuthenticated()
        && firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'developer']
        && isValidImageUpload();
    }

    // Exported reports & diagnostics: workspaces/{workspaceId}/exports/*
    match /workspaces/{workspaceId}/exports/{fileName} {
      allow read: if isAuthenticated()
        && firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
      allow write: if isAuthenticated()
        && firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role in ['owner', 'admin', 'developer']
        && isValidReportUpload();
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}


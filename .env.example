# Firebase Client Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=deployhq-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=deployhq-prod
VITE_FIREBASE_STORAGE_BUCKET=deployhq-prod.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=your-web-push-vapid-public-key
VITE_RECAPTCHA_SITE_KEY=your-app-check-recaptcha-v3-site-key
VITE_USE_FIREBASE_EMULATOR=false

# GitHub OAuth Public Client ID (Secret stored ONLY in Cloud Functions Secret Manager)
VITE_GITHUB_CLIENT_ID=Iv1.your_github_oauth_client_id

# Razorpay Public Key ID (Key Secret & Webhook Secret stored ONLY in Cloud Functions Secret Manager)
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key_id

